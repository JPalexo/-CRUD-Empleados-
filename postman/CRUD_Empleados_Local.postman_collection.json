    {
      "name": "03 - Login simbolico empleado",
      "item": [
        {
          "name": "POST Login simbolico exitoso (200, sin token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Authenticated flag is true', function () {",
                  "  pm.expect(data.authenticated).to.eql(true);",
                  "});",
                  "pm.test('Identity payload has normalized email', function () {",
                  "  pm.expect(data.empleado.email).to.eql(pm.variables.get('empleadoEmailNormalizado'));",
                  "});",
                  "pm.test('No token/session fields are present', function () {",
                  "  pm.expect(data).to.not.have.property('token');",
                  "  pm.expect(data).to.not.have.property('sessionId');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{empleadoEmailRaw}}\",\n  \"password\": \"{{empleadoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/empleados/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "empleados",
                "login"
              ]
            }
          }
