  "item": [
    {
      "name": "01 - Smoke CRUD",
      "item": [
        {
          "name": "GET Listar empleados (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Envelope contains data and pagination', function () {",
                  "  pm.expect(data).to.have.property('data');",
                  "  pm.expect(data).to.have.property('pagination');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/empleados?page={{page}}&size={{size}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "empleados"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "size",
                  "value": "{{size}}"
                }
              ]
            }
          }
        },
        {
          "name": "POST Crear empleado (201) y guardar clave",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('clave', data.clave);",
                  "pm.environment.set('clave', data.clave);",
                  "pm.test('Clave generada con prefijo EMP-', function () {",
                  "  pm.expect(data.clave).to.match(/^EMP-[1-9][0-9]*$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
